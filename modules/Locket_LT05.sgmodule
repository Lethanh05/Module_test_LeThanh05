[Script]

revenuecat = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/Lethanh05/Module_test_LeThanh05/refs/heads/main/js/Locket_Gold_LT.js, requires-body=true, max-size=-1, timeout=60

deleteHeader = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/Lethanh05/Module_test_LeThanh05/refs/heads/main/js/deleteHeader.js, timeout=60

locket_rc = type=http-response, pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+, script-path=https://raw.githubusercontent.com/Lethanh05/Module_test_LeThanh05/refs/heads/main/js/Locket_Mod_Unlocked.js, requires-body=true, max-size=-1, timeout=60
[MITM]
hostname = %APPEND% api.revenuecat.com, firebaseremoteconfig.googleapis.com
